BOT_TOKEN=

# Comma-separated Telegram numeric user IDs.
ADMIN_IDS=

SOL_ADDRESS=
ETH_ADDRESS=
BTC_ADDRESS=
LTC_ADDRESS=

DATABASE_URL=sqlite+aiosqlite:///bot.db
SUPPORT_USERNAME=
ORDER_EXPIRY_MINUTES=30

BTC_CONFIRMATIONS=2
ETH_CONFIRMATIONS=12
SOL_CONFIRMATIONS=32
LTC_CONFIRMATIONS=6

# Manual mode is safer for initial deployment. Hash submission alone never marks an order paid.
MANUAL_PAYMENT_APPROVAL=true
TERMS_VERSION=1
TERMS_TEXT=
HIGH_VALUE_ORDER_USD=1000
RATE_LIMIT_PER_MINUTE=30
BROADCAST_MAX_USERS=5000

# Optional CoinGecko-compatible price endpoint, e.g. https://api.coingecko.com/api/v3/simple/price
CRYPTO_PRICE_API_URL=
CRYPTO_PRICE_API_KEY=

# API mode endpoints. BTC uses a mempool.space-compatible API by default.
BTC_API_URL=https://mempool.space/api
ETH_API_URL=
SOL_API_URL=
# Litecoin endpoint must be a Litecoin mempool.space-compatible API.
LTC_API_URL=
